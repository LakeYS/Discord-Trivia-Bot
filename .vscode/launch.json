    "version": "0.2.0",
    "configurations": [

        {
            "name": "start:bot",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "node",
            "args": ["${workspaceFolder}/index.js", "--configfile=${workspaceFolder}/config_dev.json"],
            "outputCapture": "console",
            "skipFiles": ["<node_internals>/**"],
            "restart": false
        }
    ]
}
